{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "JwtSettings": {
    "Issuer": "Hopaut.Api",
    "Audience": "Hopaut.Clients",
    "TokenLifetime": "02:00:00",
    "ClockSkew": "00:00:30"
  },
  "ProxySettings": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
