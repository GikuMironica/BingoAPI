<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Hopaut.Api.Host</RootNamespace>
    <!-- Local secrets (e.g. JwtSettings:Secret) live in `dotnet user-secrets`, never in committed appsettings files. -->
    <UserSecretsId>hopaut-api-host</UserSecretsId>
    <!-- Mediator.SourceGenerator 3.0.2 warnings fail the build (messaging-integration skill §3): MSG0001 multiple handlers,
         MSG0002/MSG0003 invalid handler type, MSG0004 message with several message interfaces, MSG0005 message without handler. -->
    <WarningsAsErrors>$(WarningsAsErrors);MSG0001;MSG0002;MSG0003;MSG0004;MSG0005</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!-- Generates the mediator and its registrations at compile time; referenced only here (messaging-integration skill §3). -->
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mediator.Abstractions" />
    <!-- Design-time services for `dotnet ef` (startup project); never shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Hopaut.SharedKernel\Hopaut.SharedKernel.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Hopaut.BuildingBlocks.Application\Hopaut.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Hopaut.BuildingBlocks.Infrastructure\Hopaut.BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Hopaut.BuildingBlocks.Api\Hopaut.BuildingBlocks.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Hopaut.Modules.Identity.Api\Hopaut.Modules.Identity.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Users\Hopaut.Modules.Users.Api\Hopaut.Modules.Users.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Media\Hopaut.Modules.Media.Api\Hopaut.Modules.Media.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Posts\Hopaut.Modules.Posts.Api\Hopaut.Modules.Posts.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Attendance\Hopaut.Modules.Attendance.Api\Hopaut.Modules.Attendance.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Announcements\Hopaut.Modules.Announcements.Api\Hopaut.Modules.Announcements.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Ratings\Hopaut.Modules.Ratings.Api\Hopaut.Modules.Ratings.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Notifications\Hopaut.Modules.Notifications.Api\Hopaut.Modules.Notifications.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Moderation\Hopaut.Modules.Moderation.Api\Hopaut.Modules.Moderation.Api.csproj" />
    <ProjectReference Include="..\..\Modules\BugReports\Hopaut.Modules.BugReports.Api\Hopaut.Modules.BugReports.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Payments\Hopaut.Modules.Payments.Api\Hopaut.Modules.Payments.Api.csproj" />
    <!-- Module service registration (AddXxxModule) lives in each module's Infrastructure (plan Step 6.6, F-052). -->
    <ProjectReference Include="..\..\Modules\Identity\Hopaut.Modules.Identity.Infrastructure\Hopaut.Modules.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Users\Hopaut.Modules.Users.Infrastructure\Hopaut.Modules.Users.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Media\Hopaut.Modules.Media.Infrastructure\Hopaut.Modules.Media.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Posts\Hopaut.Modules.Posts.Infrastructure\Hopaut.Modules.Posts.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Attendance\Hopaut.Modules.Attendance.Infrastructure\Hopaut.Modules.Attendance.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Announcements\Hopaut.Modules.Announcements.Infrastructure\Hopaut.Modules.Announcements.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Ratings\Hopaut.Modules.Ratings.Infrastructure\Hopaut.Modules.Ratings.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Notifications\Hopaut.Modules.Notifications.Infrastructure\Hopaut.Modules.Notifications.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Moderation\Hopaut.Modules.Moderation.Infrastructure\Hopaut.Modules.Moderation.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\BugReports\Hopaut.Modules.BugReports.Infrastructure\Hopaut.Modules.BugReports.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Payments\Hopaut.Modules.Payments.Infrastructure\Hopaut.Modules.Payments.Infrastructure.csproj" />
  </ItemGroup>

</Project>
